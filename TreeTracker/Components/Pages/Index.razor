@page "/"
@using TreeTracker.Models
@using TreeTracker.Services
@inject TreeService TreeService
@inject ManualLogService ManualLogService
@rendermode InteractiveServer

<PageTitle>Tree Tracker</PageTitle>

<div class="header">
    <img src="images/VertivLogo.png"
         alt="Vertiv Logo"
         style="height: 100px; width: 100px; object-fit: contain; position: absolute; top: 1rem; right: 1rem;" />
    <h1>Vertiv Tree Tracker</h1>
    <p class="subtitle">Select a tree to view its parts</p>
</div>

@* Page Error *@
@if (!string.IsNullOrEmpty(pageError))
{
    <div class="page-error">⚠️ @pageError</div>
}

@* Location Tabs *@
<div class="tab-bar">
    @foreach (var location in TreeService.Locations)
    {
        <button class="tab-btn @(activeLocation == location ? "active" : "")"
                @onclick="async () => await SwitchLocation(location)">
            @location
        </button>
    }
</div>

@* Tree Grid for Active Location *@
<div class="tab-content">
    @if (isLoading)
    {
        <div class="loading">
            <p>Loading trees...</p>
        </div>
    }
    else if (treeNames == null || !treeNames.Any())
    {
        <div class="empty">
            <p>No trees currently at @activeLocation.</p>
        </div>
    }
    else
    {
        <div class="tree-grid">
            @foreach (var treeName in treeNames)
            {
                <div class="tree-card" @onclick="async () => await SelectTree(treeName)">
                    <div class="tree-icon">🌲</div>
                    <div class="tree-info">
                        <h3>@treeName</h3>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Detail Modal *@
@if (selectedTreeName != null && !showMoveDialog)
{
    <div class="tree-modal-overlay" @onclick="CloseModal">
        <div class="tree-modal" @onclick:stopPropagation="true">
            <div class="tree-modal-header">
                <h2>🌲 Tree @selectedTreeName</h2>
                <div style="display: flex; gap: 0.75rem; align-items: center;">
                    <button class="move-tree-btn" @onclick="OpenMoveDialog">📦 Move Tree</button>
                    <a class="print-traveler-btn"
                       href="/traveler/@selectedTreeName"
                       target="_blank">
                        🖨️ Print Traveler
                    </a>
                    <button class="close-btn" @onclick="CloseModal">✕</button>
                </div>
            </div>
            <div class="tree-modal-body">
                @if (!string.IsNullOrEmpty(modalError))
                {
                    <div class="page-error">⚠️ @modalError</div>
                }
                @if (isLoadingParts)
                {
                    <p>Loading parts...</p>
                }
                else if (selectedTreeParts == null || !selectedTreeParts.Any())
                {
                    <p>No parts found for this tree.</p>
                }
                else
                {
                    <table class="parts-table">
                        <thead>
                            <tr>
                                <th>Shop Order</th>
                                <th>Work Order</th>
                                <th>Tag No</th>
                                <th>Part ID</th>
                                <th>Project ID</th>
                                <th>Previous Tree</th>
                                <th>Location</th>
                                <th>Time Added</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var part in selectedTreeParts)
                            {
                                <tr>
                                    <td>@part.ShopOrderNo</td>
                                    <td>@part.WorkOrderNo</td>
                                    <td>@part.TagNo</td>
                                    <td>@part.PartID</td>
                                    <td>@part.ProjectID</td>
                                    <td>@(part.PreviousTree ?? "N/A")</td>
                                    <td>@(part.TreeLocation ?? "N/A")</td>
                                    <td>@part.TimeAdded?.ToString("MM/dd/yyyy hh:mm tt")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
}

@* Move Dialog - rendered separately outside detail modal *@
@if (showMoveDialog)
{
    <div class="tree-modal-overlay" @onclick="CloseMoveDialog">
        <div class="tree-modal move-dialog" @onclick:stopPropagation="true">
            <div class="tree-modal-header">
                <h2>📦 Move Tree @selectedTreeName</h2>
                <button class="close-btn" @onclick="CloseMoveDialog">✕</button>
            </div>
            <div class="tree-modal-body">
                <p class="move-current">
                    Currently at: <strong>@(selectedTreeParts?.FirstOrDefault()?.TreeLocation ?? "Unknown")</strong>
                </p>
                <div class="move-form">
                    <div class="form-group">
                        <label class="move-label">Select new location:</label>
                        <select class="move-select" @bind="selectedNewLocation">
                            <option value="">-- Select a location --</option>
                            @foreach (var loc in TreeService.Locations
                                                    .Where(l => l != selectedTreeParts?.FirstOrDefault()?.TreeLocation))
                            {
                                <option value="@loc">@loc</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="move-label">User ID:</label>
                        <input class="search-input"
                               type="text"
                               placeholder="Enter your user ID..."
                               @bind="moveUserId"
                               @bind:event="oninput" />
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(moveError))
                {
                    <p class="move-error">⚠️ @moveError</p>
                }
            </div>
            <div class="move-dialog-footer">
                <button class="close-popup-btn secondary" @onclick="CloseMoveDialog">Cancel</button>
                <button class="close-popup-btn" @onclick="ConfirmMove"
                        disabled="@(isMoving || string.IsNullOrWhiteSpace(moveUserId) || string.IsNullOrWhiteSpace(selectedNewLocation))">
                    @(isMoving ? "Moving..." : "✔ Confirm Move")
                </button>
            </div>
        </div>
    </div>
}

@* Move Success Toast *@
@if (showMoveSuccess)
{
    <div class="move-toast">
        ✅ Tree @lastMovedTree successfully moved to @lastMovedLocation!
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "location")]
    public string? LocationParam { get; set; }

    private IEnumerable<string>? treeNames;
    private IEnumerable<TreeTrackerItem>? selectedTreeParts;
    private string? selectedTreeName = null;
    private string activeLocation = TreeService.Locations[0];
    private bool isLoading = true;
    private bool isLoadingParts = false;
    private string pageError = string.Empty;
    private string modalError = string.Empty;

    // Move dialog
    private bool showMoveDialog = false;
    private string selectedNewLocation = string.Empty;
    private string moveError = string.Empty;
    private bool isMoving = false;
    private bool showMoveSuccess = false;
    private string lastMovedTree = string.Empty;
    private string lastMovedLocation = string.Empty;
    private string moveUserId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(LocationParam) && TreeService.Locations.Contains(LocationParam))
            activeLocation = LocationParam;

        await LoadTreesForLocation(activeLocation);
    }

    private async Task SwitchLocation(string location)
    {
        activeLocation = location;
        await LoadTreesForLocation(location);
    }

    private async Task LoadTreesForLocation(string location)
    {
        isLoading = true;
        pageError = string.Empty;
        var result = await TreeService.GetTreeNamesByLocationAsync(location);
        if (result.Success)
            treeNames = result.Data;
        else
            pageError = result.ErrorMessage!;
        isLoading = false;
    }

    private async Task SelectTree(string treeName)
    {
        selectedTreeName = treeName;
        isLoadingParts = true;
        modalError = string.Empty;
        var result = await TreeService.GetPartsByTreeAsync(treeName);
        if (result.Success)
            selectedTreeParts = result.Data;
        else
            modalError = result.ErrorMessage!;
        isLoadingParts = false;
    }

    private void CloseModal()
    {
        selectedTreeName = null;
        selectedTreeParts = null;
        modalError = string.Empty;
    }

    private void OpenMoveDialog()
    {
        selectedNewLocation = string.Empty;
        moveError = string.Empty;
        moveUserId = string.Empty;
        showMoveDialog = true;
    }

    private void CloseMoveDialog()
    {
        showMoveDialog = false;
        moveError = string.Empty;
    }

    private async Task ConfirmMove()
    {
        if (string.IsNullOrEmpty(selectedNewLocation))
        {
            moveError = "Please select a location.";
            return;
        }
        if (string.IsNullOrWhiteSpace(moveUserId))
        {
            moveError = "Please enter your user ID.";
            return;
        }

        isMoving = true;
        moveError = string.Empty;

        var currentLocation = selectedTreeParts?.FirstOrDefault()?.TreeLocation ?? string.Empty;

        var moveResult = await TreeService.MoveTreeAsync(selectedTreeName!, selectedNewLocation, selectedTreeName!);
        if (!moveResult.Success)
        {
            moveError = moveResult.ErrorMessage!;
            isMoving = false;
            return;
        }

        var logResult = await ManualLogService.LogMoveAsync(selectedTreeName!, currentLocation, selectedNewLocation, moveUserId);
        if (!logResult.Success)
            moveError = logResult.ErrorMessage!;

        lastMovedTree = selectedTreeName!;
        lastMovedLocation = selectedNewLocation;
        showMoveDialog = false;
        CloseModal();
        await LoadTreesForLocation(activeLocation);
        isMoving = false;
        showMoveSuccess = true;
        await Task.Delay(3000);
        showMoveSuccess = false;
        StateHasChanged();
    }
}