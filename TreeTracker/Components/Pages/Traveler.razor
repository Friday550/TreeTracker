@page "/traveler/{TreeName}"
@layout PrintLayout
@using TreeTracker.Models
@using TreeTracker.Services
@inject TreeService TreeService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Traveler - @TreeName</PageTitle>

<link rel="stylesheet" href="traveler.css" />

@if (isLoading)
{
    <p>Loading...</p>
}
else if (parts == null || !parts.Any())
{
    <p>No parts found for tree @TreeName.</p>
}
else
{
    <div class="traveler-page">
        <div class="traveler-header">
            <div class="traveler-title">
                <h1>Tree Traveler</h1>
                <h2>@TreeName</h2>
            </div>
            <div id="qrcode" class="qr-code"></div>
        </div>

        <table class="traveler-table">
            <thead>
                <tr>
                    <th>Project ID</th>
                    <th>Shop Order</th>
                    <th>Work Order</th>
                    <th>Tag No</th>
                    <th>Part ID</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var part in parts)
                {
                    <tr>
                        <td>@part.ProjectID</td>
                        <td>@part.ShopOrderNo</td>
                        <td>@part.WorkOrderNo</td>
                        <td>@part.TagNo</td>
                        <td>@part.PartID</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="traveler-footer">
            <p>Printed: @DateTime.Now.ToString("MM/dd/yyyy hh:mm tt")</p>
        </div>
    </div>
    <div class="no-print">
        <button class="print-btn" onclick="window.print()">🖨️ Print</button>
        @* <button @onclick="TestQR">Test QR</button> *@
    </div>

}

@code {
    [Parameter]
    public string TreeName { get; set; } = string.Empty;

    private IEnumerable<TreeTrackerItem>? parts;
    private bool isLoading = true;

    // private async Task TestQR()
    // {
    //     await JS.InvokeVoidAsync("generateQRCode", TreeName);
    // }

    protected override async Task OnInitializedAsync()
    {
        parts = await TreeService.GetPartsByTreeAsync(TreeName);
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && parts != null && parts.Any())
        {
            await Task.Delay(1500);
            await JS.InvokeVoidAsync("generateQRCode", TreeName);
        }
    }
}