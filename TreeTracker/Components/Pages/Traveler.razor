@page "/traveler/{TreeName}"
@layout PrintLayout
@using TreeTracker.Models
@using TreeTracker.Services
@using QRCoder
@inject TreeService TreeService
@rendermode InteractiveServer

<PageTitle>Traveler - @TreeName</PageTitle>

<link rel="stylesheet" href="traveler.css" />

@if (isLoading)
{
    <p>Loading...</p>
}
else if (parts == null || !parts.Any())
{
    <p>No parts found for tree @TreeName.</p>
}
else
{
    <div class="traveler-page">
        <div class="traveler-header">
            <div class="traveler-title">
                <img src="images/VertivLogo.png" alt="Vertiv Logo" style="height: 100px; width: 100px; object-fit: contain;" />
                <h1>Tree Traveler</h1>
                <h2>@TreeName</h2>
            </div>
            <div class="qr-section">
                @if (!string.IsNullOrEmpty(qrCodeBase64))
                {
                    <img src="data:image/png;base64,@qrCodeBase64"
                         width="128" height="128" alt="QR Code" />
                }
            </div>
        </div>

        <table class="traveler-table">
            <thead>
                <tr>
                    <th>Project ID</th>
                    <th>Shop Order</th>
                    <th>Work Order</th>
                    <th>Tag No</th>
                    <th>Part ID</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var part in parts)
                {
                    <tr>
                        <td>@part.ProjectID</td>
                        <td>@part.ShopOrderNo</td>
                        <td>@part.WorkOrderNo</td>
                        <td>@part.TagNo</td>
                        <td>@part.PartID</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="traveler-footer">
            <p>Printed: @DateTime.Now.ToString("MM/dd/yyyy hh:mm tt")</p>
        </div>
    </div>

    <div class="no-print">
        <button class="print-btn" onclick="window.print()">🖨️ Print</button>
    </div>
}

@code {
    [Parameter]
    public string TreeName { get; set; } = string.Empty;

    private IEnumerable<TreeTrackerItem>? parts;
    private string qrCodeBase64 = string.Empty;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        parts = await TreeService.GetPartsByTreeAsync(TreeName);
        qrCodeBase64 = GenerateQRCode(TreeName);
        isLoading = false;
    }

    private string GenerateQRCode(string text)
    {
        using var qrGenerator = new QRCodeGenerator();
        using var qrData = qrGenerator.CreateQrCode(text, QRCodeGenerator.ECCLevel.H);
        using var qrCode = new PngByteQRCode(qrData);
        var qrBytes = qrCode.GetGraphic(4);
        return Convert.ToBase64String(qrBytes);
    }
}